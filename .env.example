# Required for the Command Center to call the CivicShield Platform API.
# There are no default credentials: when these are unset the request is sent
# without an Authorization header and the platform rejects it (fail closed).
CIVICSHIELD_SIMULATOR_URL=http://localhost:8081
CIVICSHIELD_PLATFORM_URL=http://localhost:8080
CIVICSHIELD_PLATFORM_USER=
CIVICSHIELD_PLATFORM_PASSWORD=
